rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Tambahkan email admin kedua di dalam [ ] kalau sudah ada
      return request.auth != null && request.auth.token.email in ['wilkdez@gmail.com'];
    }
    match /site/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{id} {
      allow read: if true; allow write: if isAdmin();
      // link file/demo/source disimpan di sini; kalau project wajib login, hanya user login yang bisa baca
      match /priv/{d} {
        allow read: if isAdmin() || request.auth != null
          || get(/databases/$(database)/documents/projects/$(id)).data.caps.login != true;
        allow write: if isAdmin();
      }
    }
    // rekap trafik: 1 dokumen per hari, pengunjung hanya boleh menambah +1
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if day.size() == 10 && request.resource.data.keys().hasOnly(['views','uniq'])
        && request.resource.data.views == 1 && request.resource.data.uniq in [0,1];
      allow update: if request.resource.data.keys().hasOnly(['views','uniq'])
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.uniq - resource.data.uniq in [0,1];
    }
  }
}
