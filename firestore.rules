rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{doc} {
      allow read: if true;
      // GANTI dengan 2 email admin kamu
      allow write: if request.auth != null
        && request.auth.token.email in ['EMAIL_ADMIN_1@gmail.com','EMAIL_ADMIN_2@gmail.com'];
    }
  }
}
